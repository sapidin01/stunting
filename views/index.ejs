<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Terpadu Pencegahan Stunting</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/highcharts-more.js"></script>
    <script src="https://code.highcharts.com/modules/heatmap.js"></script>
    <script src="https://code.highcharts.com/maps/modules/map.js"></script>
</head>
<body class="bg-slate-50 font-sans text-slate-800 overflow-hidden">

    <div class="flex h-screen w-full">
        <!-- SIDEBAR MENU -->
        <aside class="w-64 bg-white border-r border-slate-200 flex flex-col shrink-0">
            <div class="h-20 flex items-center px-6 border-b border-slate-100">
                <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center mr-3">
                    <span class="material-symbols-outlined text-white text-sm">public</span>
                </div>
                <span class="font-black text-slate-800 text-lg tracking-tight">Informasi Stunting</span>
            </div>
            <nav class="flex-1 p-4 space-y-2 overflow-y-auto">
                <button onclick="switchTab('modul-1')" id="btn-modul-1" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold rounded-lg bg-blue-50 text-blue-700 transition-colors">
                    <span class="material-symbols-outlined text-[20px]">dashboard</span> Executive Panel
                </button>
                <button onclick="switchTab('modul-2')" id="btn-modul-2" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold rounded-lg text-slate-500 hover:bg-slate-50 hover:text-blue-600 transition-colors">
                    <span class="material-symbols-outlined text-[20px]">troubleshoot</span> Deteksi Anomali
                </button>
                <button onclick="switchTab('modul-3')" id="btn-modul-3" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold rounded-lg text-slate-500 hover:bg-slate-50 hover:text-blue-600 transition-colors">
                    <span class="material-symbols-outlined text-[20px]">map</span> Segmentasi Wilayah
                </button>
                <button onclick="switchTab('modul-4')" id="btn-modul-4" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold rounded-lg text-slate-500 hover:bg-slate-50 hover:text-blue-600 transition-colors">
                    <span class="material-symbols-outlined text-[20px]">account_tree</span> Analisis Kausal
                </button>
            </nav>
        </aside>

        <!-- KONTEN UTAMA -->
        <main class="flex-1 flex flex-col h-screen overflow-hidden">
            <!-- HEADER & FILTER -->
            <header class="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-8 shrink-0">
                <h1 id="header-title" class="text-2xl font-bold text-slate-800">Executive Panel</h1>
                <div class="relative inline-block min-w-[240px]">
                    <select id="filter-daerah" onchange="applyFilter()" class="block w-full appearance-none bg-white border border-slate-300 text-slate-700 py-2.5 pl-10 pr-10 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-semibold text-sm cursor-pointer hover:bg-slate-50">
                        <option value="all">Mengambil data...</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500"><span class="material-symbols-outlined text-[18px]">location_on</span></div>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-slate-500"><span class="material-symbols-outlined text-[20px]">expand_more</span></div>
                </div>
            </header>

            <!-- METADATA BAR (PRIORITAS TINGGI) -->
            <div class="bg-slate-100 text-[10px] font-bold text-slate-500 px-8 py-2 border-b border-slate-200 flex justify-between items-center shrink-0">
                <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Sumber: e-PPGBM & SIKD APBD (Live API) | Update: 3 Sep 2026</span>
                <span>Periode: TA 2026</span>
            </div>

            <div class="flex-1 overflow-y-auto p-8 relative">
                
                <div id="loading-screen" class="absolute inset-0 z-50 flex items-center justify-center bg-slate-50/80 backdrop-blur-sm">
                    <div class="text-center font-bold text-blue-600 animate-pulse">Menyiapkan Visualisasi Data...</div>
                </div>

                <!-- ============================================== -->
                <!-- MODUL 1: EXECUTIVE PANEL                       -->
                <!-- ============================================== -->
                <div id="modul-1" class="block space-y-6">

                    <div class="bg-blue-50 border-l-4 border-blue-600 p-5 rounded-r-xl shadow-sm">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="material-symbols-outlined text-blue-600 text-[20px]">insights</span>
                            <h2 class="text-sm font-black text-blue-900 uppercase tracking-wider">Insight Eksekutif Otomatis</h2>
                        </div>
                        <p id="mod1-auto-insight" class="text-xs text-blue-800 leading-relaxed text-justify">
                            Menganalisis data...
                        </p>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                            <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Pagu Anggaran Nasional</div>
                            <div id="mod1-kpi-pagu" class="text-xl font-black text-slate-800">Rp 0</div>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 border-b-4 border-b-blue-500">
                            <div class="flex justify-between items-center"><div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Realisasi Serapan</div><span class="material-symbols-outlined text-[12px] text-slate-300 cursor-help" title="Persentase serapan terhadap pagu total">help</span></div>
                            <div class="flex items-end gap-2">
                                <div id="mod1-kpi-realisasi" class="text-xl font-black text-blue-700">Rp 0</div>
                                <div id="mod1-kpi-persen" class="text-sm font-bold text-blue-500 mb-0.5">(0%)</div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                            <div class="flex justify-between items-center"><div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Total Anak Stunting</div><span class="material-symbols-outlined text-[12px] text-slate-300 cursor-help" title="Data absolut dari intervensi e-PPGBM">help</span></div>
                            <div id="mod1-kpi-kasus" class="text-xl font-black text-slate-800">0 <span class="text-xs font-normal text-slate-500">Anak</span></div>
                        </div>
                        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 border-b-4 border-b-emerald-500">
                            <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Laju Penurunan (YoY)</div>
                            <div class="text-xl font-black text-emerald-600 flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">trending_down</span> 2.4%</div>
                        </div>
                    </div>

                    <div class="flex flex-col lg:flex-row gap-6">
                        <div class="w-full lg:w-2/3 bg-white rounded-xl shadow-sm border border-slate-200 p-6 relative">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-bold text-slate-800 text-lg">Peta Sebaran Nasional (Provinsi)</h3>
                                <div class="bg-slate-100 rounded p-1 flex gap-1"><button class="text-[10px] font-bold px-2 py-1 bg-white shadow-sm rounded text-blue-600">Absolut</button><button class="text-[10px] font-bold px-2 py-1 text-slate-500">Prevalensi /1000</button></div>
                            </div>
                            <div id="map-executive" class="w-full h-[450px]"></div>
                        </div>
                        <div class="w-full lg:w-1/3 bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col">
                            <div class="flex justify-between items-center border-b border-slate-100 pb-2 mb-2"><h3 class="font-bold text-slate-800 text-sm uppercase tracking-wider">Postur Pembiayaan</h3><span class="material-symbols-outlined text-[14px] text-slate-400 cursor-help" title="Komposisi sumber pembiayaan intervensi stunting">help</span></div>
                            <div id="chart-sumber-dana" class="w-full flex-grow min-h-[300px]"></div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                            <div class="flex justify-between items-center border-b border-slate-100 pb-2 mb-4"><h3 class="font-bold text-slate-800 text-sm uppercase tracking-wider">Tren Serapan vs Kasus</h3><span class="text-[10px] text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded">Garis Hijau: Target RPJMN</span></div>
                            <div id="chart-tren-korelasi" class="w-full h-[300px]"></div>
                        </div>
                        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
                            <h3 class="font-bold text-slate-800 text-xs mb-3 uppercase tracking-wider border-b border-slate-100 pb-2">Mismatch Alokasi vs Kebutuhan (Top 5)</h3>
                            <table class="w-full text-left">
                                <thead><tr class="border-b border-slate-200"><th class="py-2 text-[10px] font-bold text-slate-500">Provinsi</th><th class="py-2 text-[10px] font-bold text-slate-500 text-right">Kasus</th><th class="py-2 text-[10px] font-bold text-slate-500 text-right">Anggaran</th><th class="py-2 text-[10px] font-bold text-slate-500 text-right">Rasio/Anak</th></tr></thead>
                                <tbody id="mod1-table-gabungan"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- MODUL 2: DETEKSI ANOMALI                       -->
                <!-- ============================================== -->
                <div id="modul-2" class="hidden space-y-6">
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                        <div class="flex justify-between items-center mb-1">
                            <h3 class="font-bold text-slate-800 text-lg flex items-center gap-2">Grafik Kuadran Kinerja <span class="material-symbols-outlined text-[16px] text-slate-400 cursor-help" title="Mendeteksi outlier menggunakan Z-Score pada distribusi anggaran vs kasus">help</span></h3>
                            <div class="flex gap-3 text-[10px] font-bold uppercase text-slate-500">
                                <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px] text-red-500">warning</span> Inefisiensi (Merah)</span>
                                <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px] text-emerald-500">change_history</span> Suspect Data (Hijau)</span>
                            </div>
                        </div>
                        <div id="scatter-anomali" class="w-full h-[450px]"></div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                        <h3 class="font-bold text-slate-800 text-lg mb-4">Tabel Peringatan Dini (Early Warning)</h3>
                        <table class="w-full text-left border-collapse">
                            <thead><tr class="bg-slate-50 border-y border-slate-200"><th class="p-4 text-[10px] font-bold text-slate-500">Kabupaten/Kota</th><th class="p-4 text-[10px] font-bold text-slate-500 text-center">Severity</th><th class="p-4 text-[10px] font-bold text-slate-500">Kategori</th><th class="p-4 text-[10px] font-bold text-slate-500 text-right">Rasio Intervensi</th><th class="p-4 text-[10px] font-bold text-slate-500 text-center">Aksi</th></tr></thead>
                            <tbody id="table-anomali"></tbody>
                        </table>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- MODUL 3: SEGMENTASI WILAYAH                    -->
                <!-- ============================================== -->
                <div id="modul-3" class="hidden space-y-6">
                    <div class="flex flex-col xl:flex-row gap-6">
                        <div class="w-full xl:w-7/12 bg-white rounded-xl shadow-sm border border-slate-200 p-6 relative flex flex-col">
                            <h3 id="mod3-map-title" class="font-bold text-slate-800 text-lg">Distribusi Kabupaten/Kota</h3>
                            <p class="text-[11px] text-slate-500 mb-4 border-b border-slate-100 pb-3">Klik area pada peta untuk membedah data di Panel Inspeksi.</p>
                            <div id="map-segmentasi" class="w-full flex-grow min-h-[500px]"></div>
                        </div>

                        <div class="w-full xl:w-5/12 bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col overflow-hidden">
                            <div class="flex justify-between items-start border-b border-slate-100 pb-3 mb-5">
                                <div><div class="text-[10px] font-bold text-blue-600 uppercase tracking-wider mb-1" id="panel-provinsi">Nasional</div><h3 class="font-black text-slate-800 text-xl leading-tight" id="panel-kabupaten">Agregat Nasional</h3></div>
                                <div class="text-right"><div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Status Fiskal</div><div id="panel-status" class="px-2 py-1 rounded text-[10px] font-bold bg-slate-100 text-slate-500">-</div></div>
                            </div>
                            <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 mb-6">
                                <div class="flex justify-between items-center mb-1"><span class="text-xs font-bold text-slate-600 uppercase">Rasio Belanja per Anak</span><span id="panel-rasio" class="text-base font-black text-slate-800">Rp 0</span></div>
                                <p id="panel-rasio-desc" class="text-[10px] text-slate-500">Menghitung efektivitas dan kesenjangan pendanaan.</p>
                            </div>
                            <div class="mb-6">
                                <div class="flex justify-between items-center mb-2"><h4 class="text-xs font-bold text-slate-800 uppercase">Defisit Infrastruktur</h4><span class="text-[9px] font-bold text-slate-400 bg-slate-100 px-2 py-1 rounded">Garis Abu = Rata-rata</span></div>
                                <div id="chart-radar-infrastruktur" class="w-full h-[220px]"></div>
                            </div>
                            <div class="mt-auto">
                                <h4 class="text-xs font-bold text-slate-800 uppercase mb-4 border-b border-slate-100 pb-2">Cakupan Intervensi Spesifik</h4>
                                <div class="space-y-4" id="mod3-progress-bars"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- MODUL 4: ANALISIS KAUSAL                       -->
                <!-- ============================================== -->
                <div id="modul-4" class="hidden space-y-6">
                    <div class="bg-yellow-50 border border-yellow-200 p-3 rounded-lg flex items-center gap-3">
                        <span class="material-symbols-outlined text-yellow-600">warning</span>
                        <p class="text-[11px] text-yellow-800 font-medium"><strong>Disclaimer Metodologi:</strong> Nilai kausalitas diestimasi menggunakan model <em>Multivariate Linear Regression</em> (R² = 0.72). Ini adalah proyeksi kebijakan, bukan kepastian absolut.</p>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6"><h3 class="font-bold text-slate-800 text-sm uppercase tracking-wider mb-2">Matriks Efektivitas Intervensi</h3><p class="text-[10px] text-slate-500 mb-4">Korelasi antara jenis belanja spesifik terhadap penurunan kasus.</p><div id="chart-heatmap" class="w-full h-[320px]"></div></div>
                        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6"><h3 class="font-bold text-slate-800 text-sm uppercase tracking-wider mb-2 flex items-center gap-1">Determinan Dominan <span class="material-symbols-outlined text-[14px] text-slate-400 cursor-help" title="Bobot regresi faktor penghambat vs daya dorong anggaran">help</span></h3><p class="text-[10px] text-slate-500 mb-4">Faktor penyumbang terbesar vs kemampuan intervensi daerah.</p><div id="chart-tornado" class="w-full h-[320px]"></div></div>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6"><h3 class="font-bold text-slate-800 text-sm uppercase tracking-wider mb-2">Analisis Jeda Waktu (Time-Lag Effect)</h3><p class="text-[10px] text-slate-500 mb-4">Mendeteksi jeda waktu antara pencairan dana dan penurunan prevalensi.</p><div id="chart-timelag" class="w-full h-[320px]"></div></div>
                        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col">
                            <h3 class="font-bold text-slate-800 text-sm uppercase tracking-wider mb-4 border-b border-slate-100 pb-2">Simulator Alokasi (What-If Analysis)</h3>
                            <div class="flex-grow space-y-6 mt-2">
                                <div><div class="flex justify-between text-xs font-bold text-slate-700 mb-2"><span>Dana Infrastruktur Sanitasi & Air</span><span id="sim-val-sanitasi" class="text-blue-600">+0%</span></div><input type="range" id="sim-sanitasi" min="-50" max="100" value="0" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600"></div>
                                <div><div class="flex justify-between text-xs font-bold text-slate-700 mb-2"><span>Dana Bantuan Gizi Spesifik (PMT)</span><span id="sim-val-gizi" class="text-pink-600">+0%</span></div><input type="range" id="sim-gizi" min="-50" max="100" value="0" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-pink-600"></div>
                                <div><div class="flex justify-between text-xs font-bold text-slate-700 mb-2"><span>Dana Edukasi & Pendampingan</span><span id="sim-val-edukasi" class="text-emerald-600">+0%</span></div><input type="range" id="sim-edukasi" min="-50" max="100" value="0" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-emerald-600"></div>
                            </div>
                            <div class="mt-8 bg-slate-50 p-4 rounded-xl border border-slate-200 text-center relative overflow-hidden">
                                <div class="text-[10px] uppercase font-bold text-slate-500 mb-1 relative z-10">Proyeksi Penurunan Kasus (95% CI)</div>
                                <div class="text-3xl font-black text-slate-400 relative z-10 transition-colors duration-300" id="sim-result"><span id="sim-min">0</span> <span class="text-sm font-normal">s/d</span> <span id="sim-max">0</span> <span class="text-sm font-bold">Anak</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- PANGGIL SEMUA SKRIP -->
    <script src="/js/main.js"></script>
    <script src="/js/modul1.js"></script>
    <script src="/js/modul2.js"></script>
    <script src="/js/modul3.js"></script>
    <script src="/js/modul4.js"></script>
</body>
</html>